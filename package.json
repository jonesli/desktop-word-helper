{
  "name": "buzhijue-beidanci",
  "version": "1.0.0",
  "description": "桌面背单词助手 - 桌面浮动条循环展示单词及释义，利用操作间隙无意识记忆",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --settings",
    "dist": "electron-builder --win"
  },
  "keywords": [
    "背单词",
    "单词",
    "英语学习"
  ],
  "author": "jonesli",
  "license": "MIT",
  "type": "commonjs",
  "build": {
    "appId": "com.jonesli.desktop-word-helper",
    "productName": "桌面背单词助手",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "!assets/dict/_*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icons/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "桌面背单词助手"
    },
    "portable": {
      "artifactName": "桌面背单词助手-便携版.exe"
    }
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "opencc-js": "^1.4.2"
  }
}
